{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "YOUR_API_KEY"
      ]
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    },
    "n8n-mcp": {
      "type": "http",
      "url": "https://n8n.akubrecah.com/mcp-server/http",
      "serverUrl": "https://n8n.akubrecah.com/mcp-server/http",
      "headers": {
        "Authorization": "Bearer ${N8N_MCP_API_KEY}"
      }
    }
  }
}
