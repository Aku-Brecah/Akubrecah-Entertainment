# ============================================================
# Akubrecah Enterprise & KRA Portal — Environment Variables
# Copy this to .env (local) or configure in deployment platform
# ============================================================

# --- Environment & Runtime Tier ---
# 'development' | 'staging' | 'production'
NODE_ENV=production
APP_ENV=production
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_URL=https://akubrecah.com

# --- Database & Prisma (Neon PostgreSQL) ---
# For Staging: Use an isolated staging database branch (e.g. Neon branching)
# For Production: Use pooled connection string for DATABASE_URL and direct connection for DIRECT_URL
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]/[DATABASE]?sslmode=require"
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[HOST]/[DATABASE]?sslmode=require"

# --- Evolution API Dedicated Postgres Password (Docker Compose) ---
EVOLUTION_DB_PASSWORD=generate-a-strong-random-password

# --- Clerk Authentication ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
# Super Admin identity — REQUIRED in production. There is NO hardcoded
# fallback: if unset, admin identity checks fail closed and admin surfaces
# won't unlock. Set it to the owner's Clerk account email.
SUPER_ADMIN_EMAIL=
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=
CLERK_DEV_SECRET_KEY=

# --- Redis Distributed Cache & Rate Limiting ---
# Supports standard Redis (redis://redis:6379) or Upstash Redis URL
# If offline/unreachable, platform automatically falls back to in-memory LRU limiter
REDIS_URL=redis://redis:6379
RATE_LIMIT_STRICT=10
RATE_LIMIT_LOOKUP=30
RATE_LIMIT_GENERAL=100
RATE_LIMIT_HEALTH=1200

# --- Observability & Crash Reporting (Sentry) ---
# Sentry captures frontend exceptions, server crashes, and API failures.
# Leave empty in local dev for graceful zero-error degradation.
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production
SENTRY_ORG=akubrecah
SENTRY_PROJECT=akubrecah-kra

# --- Privacy-Conscious Analytics (PostHog & In-House) ---
# Local in-house PostgreSQL event tracking is active by default at $0 cost.
# To mirror events into PostHog Cloud, configure the public key:
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Feature Flags Overrides (Optional) ---
# Overrides database defaults at boot time:
# FEATURE_FLAG_ENABLE_MPESA_STK_PUSH=true
# FEATURE_FLAG_ENABLE_CYBER_CAFE_SUBSCRIPTION=true
# FEATURE_FLAG_ENABLE_NIL_TAX_FILING=false
# FEATURE_FLAG_ENABLE_WHATSAPP_BOT_AI=true
# FEATURE_FLAG_MAINTENANCE_MODE=false

# --- Safaricom Daraja M-Pesa Live Production API ---
# Production API: https://api.safaricom.co.ke
# Both DARAJA_* and MPESA_* aliases are supported; DARAJA_* takes precedence if both are set.
DARAJA_ENVIRONMENT=production
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_TILL_NUMBER=
DARAJA_PARTYB=
DARAJA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://kra.akubrecah.com/api/mpesa/callback
DARAJA_CALLBACK_TOKEN=

MPESA_ENV=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_TILL_NUMBER=
MPESA_PARTYB=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
MPESA_CALLBACK_URL=https://kra.akubrecah.com/api/mpesa/callback
MPESA_DOWNLOAD_FEE_KES=20
MPESA_SUBSCRIPTION_AMOUNT_KES=500

# --- WhatsApp (Evolution API) ---
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=your_secure_evolution_api_key_here
EVOLUTION_INSTANCE_NAME=akubrecah-kra
ADMIN_WHATSAPP_NUMBERS=254712345678,254700000000
# Generate a strong PIN (min 6 digits, not a date/birthday) and rotate it.
# Never deploy with a default PIN value — the admin gate fails closed when unset.
ADMIN_BOT_PIN=
WEBHOOK_GLOBAL_URL=https://akubrecah.com/api/whatsapp/webhook

# --- n8n Workflow Automation ---
N8N_KRA_DELIVERY_WEBHOOK=https://n8n.vybeafrica.org/webhook/kra-delivery
# Scoped secret n8n forwards when calling /api/generate-certificate.
# Prefer this over reusing EVOLUTION_API_KEY: the n8n dispatch body carries
# it, so it must be a credential whose only power is certificate issuance.
# Generate with: openssl rand -hex 24
N8N_DISPATCH_SECRET=

# --- Cryptography & Security ---
ENCRYPTION_KEY=generate-a-strong-random-string-min-32-chars
JWT_SECRET=generate-another-strong-random-string
HMAC_SECRET=generate-yet-another-strong-random-string

# --- KRA Official Live API Integration ---
KRA_API_BASE_URL=https://api.kra.go.ke
KRA_PIN_CONSUMER_KEY=your-kra-pin-consumer-key
KRA_PIN_CONSUMER_SECRET=your-kra-pin-consumer-secret
KRA_ID_CONSUMER_KEY=your-kra-id-consumer-key
KRA_ID_CONSUMER_SECRET=your-kra-id-consumer-secret

# --- AI Models ---
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# --- SMTP / Inquiry Replies (required by lib/email/reply.ts) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=you@yourdomain.com
SMTP_REPLY_TO=

# --- Network / KRA scraping ---
# Outbound proxy used to reach KRA endpoints
KRA_PROXY_URL=
PROXY_URL=
# Disable TLS certificate verification for KRA scraping ONLY as a last resort (MITM risk)
KRA_ALLOW_INSECURE_TLS=false

# --- WhatsApp webhooks ---
# Secret Evolution callers must present (x-webhook-secret / apikey)
EVOLUTION_WEBHOOK_SECRET=

# --- M-Pesa (Daraja) callback authentication ---
# MANDATORY in production: /api/mpesa/callback fails CLOSED (HTTP 503) when
# this is unset. Configure it, then register the callback URL as
# <MPESA_CALLBACK_URL>?token=<MPESA_CALLBACK_TOKEN> in the Daraja portal.
MPESA_CALLBACK_TOKEN=

# --- Proxy provenance for rate limiting ---
# Secret Caddy forwards via X-Internal-Proxy-Secret (header_up) so the
# app can trust cf-connecting-ip/x-forwarded-for. Generate with:
#   openssl rand -hex 32
# Must match between the Caddy container env and this app's env.
# MANDATORY in production: when unset, the app fails CLOSED and every
# direct-origin caller shares one rate-limit bucket ("untrusted-shared-bucket").
# Only set RATE_LIMIT_TRUST_HEADERS=1 if you accept trusting spoofable
# proxy headers WITHOUT the shared-secret handshake (insecure legacy mode).
# --- Additional Integrations (Optional) ---
GITHUB_TOKEN=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_WRITE_REVIEW_URL=
GOOGLE_MAPS_URL=
EVOLUTION_BOT_NUMBER=
ADMIN_WHATSAPP_NUMBER=
ADMIN_EMAIL=
ADMIN_NOTIFICATION_EMAIL=
SUPPORT_EMAIL=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_AUTH_TOKEN=
APP_PORT=3005
EVOLUTION_PORT=8085
SERVER_URL=https://wa.akubrecah.com
VPS_HOST=
VPS_USER=root
REMOTE_DIR=/var/www/akubrecah

INTERNAL_PROXY_SECRET=
RATE_LIMIT_TRUST_HEADERS=
