# ============================================================
# Akubrecah Enterprise & KRA Portal — Environment Variables
# Copy this to .env (local) or configure in deployment platform
# ============================================================

# --- Environment & Runtime Tier ---
# 'development' | 'staging' | 'production'
NODE_ENV=production
APP_ENV=production
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_URL=https://akubrecah.com

# --- Database & Prisma (PostgreSQL / Supabase / Neon) ---
# For Staging: Use an isolated staging database branch (e.g. Neon branching or staging project)
# For Production: Use connection pooler on port 6543 (pgbouncer=true) and direct on 5432
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
# STAGING_DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[STAGING-REF].supabase.co:6543/postgres?pgbouncer=true"

# --- Clerk Authentication ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
SUPER_ADMIN_EMAIL=poweldayck@gmail.com
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=poweldayck@gmail.com

# --- Supabase Client ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Redis Distributed Cache & Rate Limiting ---
# Supports standard Redis (redis://redis:6379) or Upstash Redis URL
# If offline/unreachable, platform automatically falls back to in-memory LRU limiter
REDIS_URL=redis://redis:6379
RATE_LIMIT_STRICT=10
RATE_LIMIT_LOOKUP=30
RATE_LIMIT_GENERAL=100
RATE_LIMIT_HEALTH=1200

# --- Observability & Crash Reporting (Sentry) ---
# Sentry captures frontend exceptions, server crashes, and API failures.
# Leave empty in local dev for graceful zero-error degradation.
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production
SENTRY_ORG=akubrecah
SENTRY_PROJECT=akubrecah-kra

# --- Privacy-Conscious Analytics (PostHog & In-House) ---
# Local in-house PostgreSQL event tracking is active by default at $0 cost.
# To mirror events into PostHog Cloud, configure the public key:
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Feature Flags Overrides (Optional) ---
# Overrides database defaults at boot time:
# FEATURE_FLAG_ENABLE_PAYSTACK_GATEWAY=true
# FEATURE_FLAG_ENABLE_MPESA_STK_PUSH=true
# FEATURE_FLAG_ENABLE_CYBER_CAFE_SUBSCRIPTION=true
# FEATURE_FLAG_ENABLE_NIL_TAX_FILING=false
# FEATURE_FLAG_ENABLE_WHATSAPP_BOT_AI=true
# FEATURE_FLAG_MAINTENANCE_MODE=false

# --- Paystack Integration (Cards, Apple Pay, M-Pesa) ---
# In Staging: Strictly use test keys (sk_test_... and pk_test_...)
# In Production: Use live keys (sk_live_... and pk_live_...)
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_SUBSCRIPTION_AMOUNT_KES=300
PAYSTACK_DOWNLOAD_FEE_KES=20

# --- M-Pesa Safaricom Daraja API ---
# In Staging: Use Safaricom sandbox credentials (https://developer.safaricom.co.ke)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://akubrecah.com/api/mpesa/callback

# --- WhatsApp (Evolution API) ---
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=akubrecah_secret_whatsapp_key_2026
EVOLUTION_INSTANCE_NAME=akubrecah-kra
ADMIN_WHATSAPP_NUMBERS=254712345678,254700000000
ADMIN_BOT_PIN=8426
WEBHOOK_GLOBAL_URL=https://akubrecah.com/api/whatsapp/webhook

# --- n8n Workflow Automation ---
N8N_KRA_DELIVERY_WEBHOOK=https://n8n.vybeafrica.org/webhook/kra-delivery

# --- Cryptography & Security ---
ENCRYPTION_KEY=generate-a-strong-random-string-min-32-chars
JWT_SECRET=generate-another-strong-random-string
HMAC_SECRET=generate-yet-another-strong-random-string

# --- KRA Official Live API Integration ---
KRA_API_BASE_URL=https://api.kra.go.ke
KRA_PIN_CONSUMER_KEY=your-kra-pin-consumer-key
KRA_PIN_CONSUMER_SECRET=your-kra-pin-consumer-secret
KRA_ID_CONSUMER_KEY=your-kra-id-consumer-key
KRA_ID_CONSUMER_SECRET=your-kra-id-consumer-secret

# --- AI Models ---
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
